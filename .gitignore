# .claude/* rather than .claude/, because git cannot re-include a file whose parent directory
# is excluded. The hand-written project CLAUDE.md is tracked; the compiled stack-rules.md
# snapshot, settings.local.json and everything else under it stay local.
.claude/*
!.claude/CLAUDE.md
.vscode/
graphify-out/
node_modules/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
**/__pycache__/
.reference/
.test/
.planning/
/.idea/

# stray output from the graphify global-sync PostToolUse hook
graphify-sync.log
